# Copy to .env and fill in. Never commit .env.
# Everything here has a default in config.js except JWT_SECRET.

# ── Website API (required for the site to work at all) ───────────────────

# REQUIRED. At least 32 chars, or the API server declines to start (the bot
# still runs). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Also used to derive public player ids and to hash OTP codes, so changing it
# signs everyone out and invalidates pending codes.
JWT_SECRET=

# The port Express listens on inside the VPS. This MUST match what your
# Cloudflare Origin Rule forwards to (Rules → Origin Rules → "Forward to
# backend port"). Nothing else may be bound to it — check with:
#   sudo lsof -i :5786
API_PORT=5786

# Public HTTPS origin the API is reachable at from the internet, via the
# Cloudflare Origin Rule. Used to build absolute avatar/banner image URLs.
PUBLIC_API_URL=https://animeastral.qzz.io

# Exact frontend origins allowed to call the API with credentials.
# Comma-separated. No wildcards, no trailing slashes — CORS with credentials
# rejects wildcards. Add Vercel preview domains here if you want them working.
ALLOWED_ORIGINS=https://playastral.qzz.io,https://astral-play.vercel.app

# The player-facing WEBSITE origin — where people sign up, log in, and read
# their notification bell. This is the FRONTEND, not PUBLIC_API_URL above.
# .connect sends Discord/Telegram players here to collect their link code, so
# if this is wrong they get sent to a page that can't show it to them.
SITE_URL=https://playastral.qzz.io

# How long a login code stays valid. Default 5 minutes.
OTP_TTL_MS=300000

# LEAVE UNSET IN PRODUCTION. When true, /api/auth/request-otp echoes the login
# code back in its JSON response, so anyone could sign in as anyone else
# without seeing the WhatsApp DM. Local testing only.
# DEV_MODE=false

# ── Bot identity ────────────────────────────────────────────────────────

BOT_NAME=Astral of the Sun
BOT_NAME_2=Astral of the Moon

# Country code assumed when a player types a LOCAL number (one leading 0) on
# the login page — 0706… becomes 234706…. Must match where your players
# actually dial from. Full international input (+92…, 0092…) is never touched.
DEFAULT_COUNTRY_CODE=234

# The number people DM to play. Shown on the site so players know who the OTP
# DM will come from. Public by design.
BOT_PUBLIC_NUMBER=

# Naira per US dollar, used only to label prices on the website's premium page.
# Payment is still taken in naira. Leave blank to show naira only.
NAIRA_PER_USD=1385

# Owner/admin. OWNER_NUMBERS is comma-separated.
OWNER_NUMBERS=
OWNER_LID=

SUPPORT_GROUP_LINK=

# Community invite links — one per platform, used by .whatsapp / .telegram /
# .discord (plugins/community-links.js). Leave any of these blank and that
# command just says the link isn't set up yet instead of posting nothing.
COMMUNITY_WHATSAPP_LINK=
COMMUNITY_TELEGRAM_LINK=
COMMUNITY_DISCORD_LINK=

# ── Storage ─────────────────────────────────────────────────────────────

# Leave these commented out unless you know you moved the files. config.js
# defaults to ./auth_info and ./paired_number.txt — pointing them somewhere
# else makes the bot think it has no session and ask to pair again.

DB_PATH=./db.json
# AUTH_FOLDER=./auth_info
# AUTH_FOLDER_2=./auth_info_2
# PHONE_FILE=./paired_number.txt
# PHONE_FILE_2=./paired_number2.txt

# ── Off-box backup of the database (recommended) ────────────────────────
#
# DB_PATH above stays the live database. Set MONGO_URI and every save is ALSO
# copied up to MongoDB the moment it lands on disk, the way Vercel redeploys
# your site the moment you push to GitHub. The bot never waits on the network,
# so a slow or dead cluster can't make a command feel laggy, and the file can be
# deleted, corrupted, or lost with the whole box: on the next boot, if DB_PATH
# is missing or empty, the bot downloads the world back down and writes the file
# out again before it serves a single message.
#
# Leave MONGO_URI blank and nothing changes — DB_PATH is the only copy, exactly
# as before.
#
# Getting the string (free tier is plenty):
#   1. mongodb.com/cloud/atlas -> create a free M0 cluster
#   2. Database Access -> Add New Database User -> password auth, note both
#   3. Network Access -> Add IP Address -> add your VPS's IP.
#      0.0.0.0/0 works from anywhere but means the password is the only thing
#      protecting all player data, so prefer the real IP.
#   4. Database -> Connect -> Drivers -> copy the mongodb+srv:// string and put
#      your real password in place of <password>
#
# If the password contains @ : / ? # or % it must be percent-encoded, or the
# driver misreads where the host starts.
MONGO_URI=

# Which database inside the cluster. Change it to run a second, separate world
# on the same cluster (a test bot alongside the live one).
MONGO_DB_NAME=astral

# Only for emergencies. The bot writes a heartbeat lock into the database so
# two machines can never back up one world at the same time; this skips that
# check. A crashed owner releases itself after 90 seconds anyway.
# MONGO_ALLOW_SECOND_WRITER=false
#
# First upload (bot stopped):  node scripts/db-mongo.mjs push
# Check both sides any time:   node scripts/db-mongo.mjs status
# Download a copy:             node scripts/db-mongo.mjs pull

# ── Payments (served at runtime by /api/premium, never baked into the site) ──

BANK_NAME=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=

# ── Third-party keys ────────────────────────────────────────────────────

OMDB_API_KEY=
IMGBB_API_KEY=

# Pixelcut — enables .upscale. No default; the command says it's unconfigured
# and does nothing until this is set.
PIXELCUT_API_KEY=

# ── Logging ─────────────────────────────────────────────────────────────

# trace | debug | info | warn | error
LOG_LEVEL=info

# ── Discord & Telegram ──────────────────────────────────────────────────
#
# The same RPG runs on all three platforms. How you start it decides whether
# players share one character or get a separate one per platform:
#
#   npm run start:all        one process, one db.json, ONE character shared
#                            across WhatsApp + Discord + Telegram
#   npm run start:discord    separate process, its own db-discord.json
#   npm run start:telegram   separate process, its own db-telegram.json
#
# Do NOT point two processes at the same DB_PATH. Only one process may write
# a given db.json (see lib/player-repo.js) — a second writer silently corrupts
# saves. The bot now refuses to start rather than let that happen.

# Discord — https://discord.com/developers/applications
#   Bot → Reset Token → paste here.
#   Bot → Privileged Gateway Intents → enable MESSAGE CONTENT and SERVER MEMBERS.
#   Without those two intents the bot connects but never sees any message text.
DISCORD_TOKEN=
DISCORD_BOT_NAME=Astral RPG

# Your Discord user id, so the bot treats you as owner there. OWNER_NUMBERS
# can't cover this — a Discord id is not a phone number. Comma-separated.
# Get it: User Settings → Advanced → Developer Mode on, then right-click your
# name → Copy User ID. Leave empty and only channel admins pass the admin gate.
DISCORD_OWNER_IDS=

# Telegram — message @BotFather → /newbot → copy the token.
#   Then /setprivacy → your bot → DISABLE, or the bot only sees /slash commands
#   and never the "." prefix this bot actually uses.
TELEGRAM_TOKEN=
TELEGRAM_BOT_NAME=Astral RPG

# Your Telegram user id (numeric). Message @userinfobot to get it.
# Comma-separated. Same role as DISCORD_OWNER_IDS above.
TELEGRAM_OWNER_IDS=

# Telegram players reach for "/" by reflex, so that platform accepts it IN
# ADDITION to the global "." prefix — /menu and .menu both work there.
# Only change this if "/" clashes with something; "." is always accepted and
# is what all 445 help strings in the bot print.
# TELEGRAM_PREFIX=/
